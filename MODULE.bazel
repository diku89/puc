module(
    name = "puc",
    version = "0.1.0",
)

bazel_dep(name = "rules_cc", version = "0.2.22")
bazel_dep(name = "mbedtls", version = "3.6.5")
bazel_dep(name = "protobuf", version = "33.4")
bazel_dep(name = "sqlite3", version = "3.53.3")

bazel_dep(name = "googletest", version = "1.17.0.bcr.2", dev_dependency = True)
bazel_dep(name = "platforms", version = "1.1.0", dev_dependency = True)
bazel_dep(name = "rules_doxygen", version = "2.6.3", dev_dependency = True)
bazel_dep(name = "rules_python", version = "2.2.0", dev_dependency = True)
bazel_dep(name = "rules_shell", version = "0.8.0", dev_dependency = True)
bazel_dep(name = "buildifier_prebuilt", version = "8.5.1.3", dev_dependency = True)
bazel_dep(
    name = "ruff_prebuilt",
    version = "0.15.19.1",
    dev_dependency = True,
    repo_name = "ruff",
)

single_version_override(
    module_name = "googletest",
    patch_strip = 1,
    patches = ["//third_party:googletest_1_17_0_char8_t.patch"],
    version = "1.17.0.bcr.2",
)

python = use_extension(
    "@rules_python//python/extensions:python.bzl",
    "python",
    dev_dependency = True,
)
python.defaults(python_version = "3.12")
python.toolchain(python_version = "3.12")

doxygen = use_extension(
    "@rules_doxygen//:extensions.bzl",
    "doxygen_extension",
    dev_dependency = True,
)
use_repo(doxygen, "doxygen")
